{
  // Worker metadata
  "name": "zealy-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-12-19",
  "observability": { "enabled": true },

  // Run every 15 minutes
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },

  // Cloudflare Browser Rendering binding for @cloudflare/puppeteer
  "browser": { "binding": "MY_BROWSER" },

  // KV binding. Fill in your namespace IDs after running:
  // npx wrangler kv namespace create ZEALY_KV
  "kv_namespaces": [
    {
      "binding": "ZEALY_KV",
      // Replace with your production namespace id
      "id": "<YOUR_PROD_KV_ID>",
      // Optionally set a separate preview namespace id for `wrangler dev`
      "preview_id": "<YOUR_PREVIEW_KV_ID>"
    }
  ]
}
